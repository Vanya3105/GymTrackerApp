<?xml version="1.0" encoding="utf-8"?>
<!--
  The collapsed live-workout notification. Android 12+ gives a collapsed custom notification
  about 48dp of height, so this is two short lines and one button; the full card with the
  +/- buttons is the expanded view. Text uses the system notification styles, so it reads on
  both light and dark notification backgrounds.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/notif_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textAppearance="@android:style/TextAppearance.Material.Notification"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notif_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/notif_done"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp">

        <ImageView
            android:id="@+id/notif_done_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_pill_bg"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/notif_done_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Set done"
            android:src="@drawable/ic_widget_check" />
    </FrameLayout>
</LinearLayout>
