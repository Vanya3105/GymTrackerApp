<?xml version="1.0" encoding="utf-8"?>
<!-- Static widget-picker preview of the recovery widget (dark theme, sample data). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Recovery"
            android:textColor="#F3F2F0"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 of 5 rested"
            android:textColor="#A3A1A8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Rings and their labels, centered together in the remaining space. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout style="@style/PreviewRingCell">
                <TextView style="@style/PreviewRing" android:background="@drawable/preview_ring_ready" android:text="100" />
            </FrameLayout>

            <FrameLayout style="@style/PreviewRingCell">
                <TextView style="@style/PreviewRing" android:background="@drawable/preview_ring_tired" android:text="40" />
            </FrameLayout>

            <FrameLayout style="@style/PreviewRingCell">
                <TextView style="@style/PreviewRing" android:background="@drawable/preview_ring_recovering" android:text="70" />
            </FrameLayout>

            <FrameLayout style="@style/PreviewRingCell">
                <TextView style="@style/PreviewRing" android:background="@drawable/preview_ring_ready" android:text="95" />
            </FrameLayout>

            <FrameLayout style="@style/PreviewRingCell">
                <TextView style="@style/PreviewRing" android:background="@drawable/preview_ring_ready" android:text="100" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView style="@style/PreviewRingLabel" android:text="Chest" />
            <TextView style="@style/PreviewRingLabel" android:text="Back" />
            <TextView style="@style/PreviewRingLabel" android:text="Shoulders" />
            <TextView style="@style/PreviewRingLabel" android:text="Arms" />
            <TextView style="@style/PreviewRingLabel" android:text="Legs" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
