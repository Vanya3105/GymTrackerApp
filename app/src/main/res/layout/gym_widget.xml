<?xml version="1.0" encoding="utf-8"?>
<!--
  Workout widget and lock-screen card: a header (tile, status, value on the right), a title and
  subtitle, and at the bottom either one action button or the set controls.
  Colors and what shows are set at runtime (see buildWorkoutWidgetViews).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/widget_header_click_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/widget_tile_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_tile_bg" />

                    <ImageView
                        android:id="@+id/widget_tile_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="4dp"
                        android:src="@drawable/ic_stat_workout" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_status_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:text="Up next"
                    android:textSize="12sp" />

                <Chronometer
                    android:id="@+id/widget_rest_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_header_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:singleLine="true"
                    android:text="1/3"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_split_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Push"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Chest, shoulders, triceps"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Takes the space between, so the bottom row sits at the bottom at any height
             (a FrameLayout: widgets can't use a plain View). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp" />

        <FrameLayout
            android:id="@+id/widget_action_button"
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/widget_action_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_action_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_play" />

                <TextView
                    android:id="@+id/widget_action_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:text="Start workout"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_controls_row"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.3">

                <ImageView
                    android:id="@+id/widget_weight_pill_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_pill_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_btn_weight_minus"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:contentDescription="−"
                        android:padding="11dp"
                        android:src="@drawable/ic_widget_remove" />

                    <TextView
                        android:id="@+id/widget_weight_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="40 kg"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/widget_btn_weight_plus"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:contentDescription="+"
                        android:padding="11dp"
                        android:src="@drawable/ic_widget_add" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_reps_group"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_reps_pill_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_pill_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_btn_reps_minus"
                        android:layout_width="30dp"
                        android:layout_height="match_parent"
                        android:contentDescription="−"
                        android:padding="10dp"
                        android:src="@drawable/ic_widget_remove" />

                    <TextView
                        android:id="@+id/widget_reps_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="8"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/widget_btn_reps_plus"
                        android:layout_width="30dp"
                        android:layout_height="match_parent"
                        android:contentDescription="+"
                        android:padding="10dp"
                        android:src="@drawable/ic_widget_add" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_complete_set"
                android:layout_width="48dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/widget_done_pill_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_pill_bg" />

                <ImageView
                    android:id="@+id/widget_done_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_check" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
